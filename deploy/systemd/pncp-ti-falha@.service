[Unit]
Description=Notifica falha de %i pela bridge WhatsApp
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projetos/pncp-ti-intel
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/uv run python -m pncp_ti.operacao falha --unidade %i
TimeoutStartSec=60
