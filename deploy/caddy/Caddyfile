# Proxy reverso da web pncp-ti (R5, ADR 0024): autenticação na frente, web só em loopback.
# Variáveis (arquivo deploy/caddy/caddy.env, fora do Git; ver README.md desta pasta):
#   PNCP_SITE_ADDRESS  endereço do site de teste local, ex.: 127.0.0.1:8443 (padrão)
#   PNCP_BIND          interface de escuta desse site (padrão 127.0.0.1)
#   PNCP_TLS           internal (CA local do Caddy, padrão) ou o e-mail para Let's Encrypt
#   PNCP_TUNNEL_HOST   domínio que o Cloudflare Tunnel entrega (padrão atas.myhomelablp.site)
#   PNCP_TUNNEL_PORT   porta HTTP em 127.0.0.1 para o cloudflared (padrão 8444)
#   PNCP_AUTH_USER / PNCP_AUTH_HASH  usuário e hash bcrypt (caddy hash-password)
{
	admin off
	# Sem o redirecionador HTTP->HTTPS na :80 de todas as interfaces.
	auto_https disable_redirects
}

# O log guarda o Cf-Connecting-IP (IP real atrás do tunnel), mas não o token do Access.
(registro) {
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>headers>Cf-Access-Jwt-Assertion delete
			}
		}
	}
}

# Tudo o que um site faz: nada chega à web sem credencial, a autenticação vem antes de qualquer rota.
(protegido) {
	basic_auth {
		{$PNCP_AUTH_USER} {$PNCP_AUTH_HASH}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	request_body {
		max_size 64KB
	}

	reverse_proxy 127.0.0.1:8000 {
		header_up Host 127.0.0.1
		header_up -X-Forwarded-For
		# O token do Cloudflare Access não serve à web; não sai do proxy.
		header_up -Cf-Access-Jwt-Assertion
	}

	import registro
}

# Teste local com TLS (CA interna).
{$PNCP_SITE_ADDRESS:127.0.0.1:8443} {
	bind {$PNCP_BIND:127.0.0.1}
	tls {$PNCP_TLS:internal}
	import protegido
}

# Entrada do Cloudflare Tunnel (opção A): o TLS público e o Access ficam na borda da Cloudflare;
# o cloudflared fala HTTP com este site só em loopback. Casa apenas pelo Host do domínio.
http://{$PNCP_TUNNEL_HOST:atas.myhomelablp.site}:{$PNCP_TUNNEL_PORT:8444} {
	bind 127.0.0.1
	import protegido
}

# Qualquer outro Host na porta do tunnel é recusado sem chegar à web.
http://:{$PNCP_TUNNEL_PORT:8444} {
	bind 127.0.0.1
	import registro
	respond 421
}
