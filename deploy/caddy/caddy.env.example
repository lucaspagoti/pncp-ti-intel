# Copie para caddy.env (fora do Git, modo 600) e preencha. O hash vai entre aspas simples por causa dos '$'.
PNCP_SITE_ADDRESS=127.0.0.1:8443
PNCP_TLS=internal
# Entrada do Cloudflare Tunnel (ADR 0024, opção A); os padrões do Caddyfile já são estes.
# PNCP_TUNNEL_HOST=atas.myhomelablp.site
# PNCP_TUNNEL_PORT=8444
PNCP_AUTH_USER=lucas
# Gere com (pede a senha sem deixá-la no histórico do shell):
#   docker run --rm -it caddy:2.8.4-alpine caddy hash-password
PNCP_AUTH_HASH='$2a$14$...'
