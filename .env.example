# Copie para .env e preencha. Nunca versione o .env.

# compras-mcp (opcional: habilita as tools de sanções; cadastro gratuito no Portal da Transparência)
TRANSPARENCIA_API_KEY=

# Postgres local (Fase 0/2) — portas só em 127.0.0.1
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=pncp_ti
POSTGRES_ADMIN_PASSWORD=
PNCP_TI_INGEST_PASSWORD=
PNCP_TI_READER_PASSWORD=

# Ingestão
PNCP_REQUESTS_PER_SECOND=2

# Identidade de fornecedores PF: gere com python -c "import secrets; print(secrets.token_hex(32))"
# Preserve no backup seguro do .env; não trocar sem migração/reingestão (ADR 0013).
PNCP_TI_IDENTITY_KEY=
