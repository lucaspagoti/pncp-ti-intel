# Copie para .env e preencha. Nunca versione o .env.

# Postgres local — portas só em 127.0.0.1
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=pncp_ti
POSTGRES_ADMIN_PASSWORD=
PNCP_TI_INGEST_PASSWORD=
PNCP_TI_READER_PASSWORD=
PNCP_TI_WEB_PASSWORD=

# Ingestão
PNCP_REQUESTS_PER_SECOND=2
ARP_REQUESTS_PER_SECOND=1.5
ARP_MAX_REQUISICOES=20000

# Identidade de fornecedores PF: gere com python -c "import secrets; print(secrets.token_hex(32))"
# Preserve no backup seguro do .env; não trocar sem migração/reingestão (ADR 0013).
PNCP_TI_IDENTITY_KEY=

# Alerta da carga diária (opcional): URL de um monitor Push do Uptime Kuma. Não versionar.
KUMA_PUSH_URL=
