# Copie para .env e preencha. Nunca versione o .env.

# Postgres local — portas só em 127.0.0.1
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=pncp_ti
POSTGRES_ADMIN_PASSWORD=
PNCP_TI_INGEST_PASSWORD=
PNCP_TI_READER_PASSWORD=
PNCP_TI_WEB_PASSWORD=

# Ingestão
PNCP_REQUESTS_PER_SECOND=2
ARP_REQUESTS_PER_SECOND=1.5
ARP_MAX_REQUISICOES=20000
# Orçamento de tempo da varredura semanal por PDM (R2.1); o que não couber continua na noite seguinte.
# 90 min fecham a carga das 03:00 por volta das 05:50 (ADR 0025, item 7); o padrão do código é 45.
ARP_VARREDURA_MINUTOS=90

# Identidade de fornecedores PF: gere com python -c "import secrets; print(secrets.token_hex(32))"
# Preserve no backup seguro do .env; não trocar sem migração/reingestão (ADR 0013).
PNCP_TI_IDENTITY_KEY=

# Alerta da carga diária (opcional): URL de um monitor Push do Uptime Kuma. Não versionar.
KUMA_PUSH_URL=

# R6: bridge existente do homelab (texto puro; exige JSON {"ok": true}).
# Exemplo local: http://127.0.0.1:3010/notify/text. Não aponta para Hermes/LLM.
PNCP_TI_NOTIFY_URL=
# Gancho R3 opcional: termo estável exato de contagens.resultados_por_termo.
# Vazio desabilita a checagem até integrar a R3.
PNCP_TI_PNCP_TERMO=
