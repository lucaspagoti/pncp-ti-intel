#!/usr/bin/env bash
# Fallback de revisão: `codex exec` somente leitura, sem aprovação nem subagentes.
# Uso: review-exec SNAPSHOT_ID PROMPT_FILE OUT_DIR ARQUIVO_ESPERADO...
# OUT_DIR fica fora do repositório. O parecer só é aceito (exit 0) se o processo
# terminar bem, o JSON validar contra o schema e a árvore não mudar durante a revisão.
set -euo pipefail

if (( $# < 4 )); then
    printf '%s\n' 'uso: review-exec SNAPSHOT_ID PROMPT_FILE OUT_DIR ARQUIVO...' >&2
    exit 64
fi
snapshot_id=$1 prompt=$2 out=$3
shift 3
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../../.." && pwd -P)"
schema="$repo_root/.claude/skills/ade-workflow/references/parecer.schema.json"
mkdir -p "$out"

fingerprint() {
    (cd "$repo_root" && git rev-parse HEAD \
        && { git ls-files -co --exclude-standard -z | xargs -0 -r sha256sum; } | sort)
    git -C "$repo_root" status --porcelain
}
fingerprint | sha256sum | cut -d' ' -f1 > "$out/tree.before"

set +e
timeout 900 codex exec --cd "$repo_root" --sandbox read-only \
    -c 'approval_policy="never"' -c 'features.multi_agent=false' \
    --ephemeral --json --output-schema "$schema" \
    -o "$out/parecer.json" - < "$prompt" > "$out/events.jsonl" 2> "$out/stderr.log"
rc=$?
set -e

fingerprint | sha256sum | cut -d' ' -f1 > "$out/tree.after"
cmp -s "$out/tree.before" "$out/tree.after" \
    || { echo 'REJEITADO: a árvore mudou durante a revisão' >&2; exit 2; }
(( rc == 0 )) || { echo "REJEITADO: codex exec terminou com código $rc" >&2; exit 3; }

python3 -I "$repo_root/.claude/skills/ade-workflow/scripts/validar_parecer.py" \
    "$out/parecer.json" "$snapshot_id" "$@"
