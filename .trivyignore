# /etc/ssl/private/ssl-cert-snakeoil.key — chave placeholder padrão do pacote
# Debian `ssl-cert`, presente em toda imagem Debian/Postgres oficial. Não é
# segredo real; não usamos SSL no Postgres local (docker-compose.yml não
# habilita, ADR 0008: tudo em 127.0.0.1).
private-key
